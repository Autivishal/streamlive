# ============================================================
# DATABASE (Neon PostgreSQL — free tier at neon.tech)
# ============================================================
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ============================================================
# AUTH.JS / NEXTAUTH
# ============================================================
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ============================================================
# ADMIN ACCOUNT (used by seed script to create first user)
# ============================================================
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-before-deploying"

# ============================================================
# CLOUDINARY (cloudinary.com — free tier)
# ============================================================
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ============================================================
# ENCRYPTION (for stream keys stored in DB)
# Generate with: openssl rand -hex 32
# ============================================================
ENCRYPTION_KEY="your-32-byte-hex-key-here"

# ============================================================
# WORKER AUTH (shared secret between Render API and local worker)
# Generate with: openssl rand -hex 32
# ============================================================
WORKER_AUTH_SECRET="your-worker-auth-secret"
