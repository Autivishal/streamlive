# ============================================================
# Worker configuration
# ============================================================

# URL to your Render web service (or http://localhost:3000 for local dev)
API_URL=https://your-render-app.onrender.com

# Worker token from Settings page of dashboard
WORKER_TOKEN=your-worker-token-here

# Full path to ffmpeg.exe on your Windows machine
# Download from https://ffmpeg.org/download.html
FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
